# Generated automatically by ./bin/setup. Do not put real tokens in this file.
HOST=127.0.0.1
PORT=8787
CHAT_ACCESS_TOKEN=generated-per-install

# Fresh installs use an ephemeral trycloudflare.com URL.
TUNNEL_MODE=quick
PUBLIC_URL=
CLOUDFLARED_BIN='/absolute/path/to/cloudflared'
SECRETS_ENV=

# WSL runtime.
GATEWAY_NODE='/absolute/path/to/wsl/node'
CODEX_BIN='/absolute/path/to/wsl/codex'
CODEX_REPOS='/home/you/tunnel-chat'
CODEX_HOME='/home/you/.codex'

# Windows Codex Desktop bridge. Keep disabled on non-WSL systems.
DESKTOP_ENABLED=1
DESKTOP_NODE='/mnt/c/Program Files/nodejs/node.exe'
DESKTOP_STAGING_ROOT='D:\dev\codex\tunnel-chat\attachments'

UPLOAD_CHUNK_BYTES=2048
UPLOAD_CONCURRENCY=3
UPLOAD_RETRY_LIMIT=4
UPLOAD_TTL_SECONDS=21600
