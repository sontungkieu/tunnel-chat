#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
export PATH="$PWD/.tools:$PATH"
uv run --frozen python server.py init-env >/dev/null

set -a
source .env.local
if [ -f "${SECRETS_ENV:-}" ]; then
    source "$SECRETS_ENV"
fi
set +a

mkdir -p logs run
PID_FILE="run/cloudflared.pid"
URL_FILE="run/cloudflared.url"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "cloudflared already running pid=$(cat "$PID_FILE")"
    [ -f "$URL_FILE" ] && cat "$URL_FILE"
    exit 0
fi

CLOUDFLARED=${CLOUDFLARED_BIN:-$(command -v cloudflared || true)}
if [ -z "$CLOUDFLARED" ] && [ -x "$PWD/.tools/cloudflared" ]; then
    CLOUDFLARED="$PWD/.tools/cloudflared"
fi
if [ ! -x "$CLOUDFLARED" ]; then
    echo "cloudflared not found; run ./bin/setup" >&2
    exit 1
fi

LOCAL_URL="http://127.0.0.1:${PORT:-8787}"
LOG_FILE="logs/cloudflared.log"
: > "$LOG_FILE"
export CLOUDFLARED LOCAL_URL LOG_FILE

uv run --frozen python - <<'PY'
from pathlib import Path
import os
import subprocess
import time

cloudflared = os.environ["CLOUDFLARED"]
local_url = os.environ["LOCAL_URL"]
log_file = Path(os.environ["LOG_FILE"])
env = os.environ.copy()
token = env.pop("CLOUDFLARE_TUNNEL_TOKEN", "")
if token:
    env["TUNNEL_TOKEN"] = token
    cmd = [
        cloudflared,
        "tunnel",
        "--no-autoupdate",
        "--logfile",
        str(log_file),
        "run",
    ]
else:
    cmd = [
        cloudflared,
        "tunnel",
        "--no-autoupdate",
        "--logfile",
        str(log_file),
        "--url",
        local_url,
    ]
with open(os.devnull, "rb") as stdin, open(os.devnull, "wb") as stdout:
    proc = subprocess.Popen(
        cmd,
        stdin=stdin,
        stdout=stdout,
        stderr=subprocess.STDOUT,
        env=env,
        start_new_session=True,
    )
Path("run/cloudflared.pid").write_text(str(proc.pid), encoding="utf-8")
time.sleep(4)
os.kill(proc.pid, 0)
PY

uv run --frozen python - <<'PY'
from pathlib import Path
import re

log = Path("logs/cloudflared.log")
url_file = Path("run/cloudflared.url")
text = log.read_text(errors="ignore") if log.exists() else ""
matches = re.findall(r"https://[-a-zA-Z0-9.]+\\.trycloudflare\\.com", text)
if matches:
    url_file.write_text(matches[-1] + "\\n", encoding="utf-8")
    print(matches[-1])
else:
    print("cloudflared started; URL is managed by the configured Cloudflare tunnel")
PY
