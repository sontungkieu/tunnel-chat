#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$PWD/.tools:$PATH"
uv run --frozen python server.py init-env >/dev/null
uv run --frozen python service.py start

set -a
source .env.local
set +a
case "${TUNNEL_MODE:-quick}" in
    local|none|"") ;;
    quick) ./bin/quick-tunnel ;;
    persistent|named) ./bin/tunnel ;;
    *) echo "Unsupported TUNNEL_MODE: $TUNNEL_MODE" >&2; exit 1 ;;
esac
