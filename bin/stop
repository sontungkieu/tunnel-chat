#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
for name in quick-cloudflared cloudflared gateway server; do
    pid_file="run/${name}.pid"
    if [ -f "$pid_file" ]; then
        pid="$(cat "$pid_file")"
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid"
            echo "stopped $name pid=$pid"
        fi
        rm -f "$pid_file"
    fi
done
